# Copy this file to .env, then replace every "insert your ..." placeholder with
# your own value.  The code reads ".env", never this template, so nothing happens
# until you make that copy:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real keys.

# --- required: extraction, screening, auto-fix, and debate panel member 1 -----
OPENAI_API_KEY=insert your OpenAI API key
# Leave the base URL alone unless you route through a proxy or compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EXTRACT_MODEL=gpt-4o
GPT4O_MODEL=gpt-4o

# --- required: debate panel member 2 -----------------------------------------
GEMINI_API_KEY=insert your Google Gemini API key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-2.5-pro

# --- required: debate panel member 3 -----------------------------------------
KIMI_API_KEY=insert your Moonshot Kimi API key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2-0711-preview

# --- required: where your PDFs live ------------------------------------------
# Any directory of PDFs, for example a Zotero storage folder or the output of
# harvest_papers.py.
PDF_CORPUS_DIR=insert the path to your PDF folder

# --- optional: paper harvesting ----------------------------------------------
HARVEST_DOWNLOAD_DIR=./pdf_corpus
PUBMED_EMAIL=insert your email for the PubMed API
NCBI_API_KEY=insert your NCBI API key, or leave blank
SEMANTIC_SCHOLAR_API_KEY=insert your Semantic Scholar API key, or leave blank

# --- optional: throughput -----------------------------------------------------
SCENARIO_WORKERS=20
SCENARIO_MAX_FILES=0
